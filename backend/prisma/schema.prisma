generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// MÓDULO 1: SEGURIDAD Y USUARIOS
// ==========================================
model Rol {
  id          Int       @id @default(autoincrement())
  nombre      String
  descripcion String?
  usuarios    Usuario[]

  @@map("roles")
}

model Usuario {
  id           Int         @id @default(autoincrement())
  rolId        Int         @map("rol_id")
  rol          Rol         @relation(fields: [rolId], references: [id])
  email        String      @unique
  passwordHash String      @map("password_hash")
  nombre       String
  telefono     String?
  creadoEn     DateTime    @default(now()) @map("creado_en")
  direcciones  Direccion[]
  ordenes      Orden[]

  @@map("usuarios")
}

model Direccion {
  id          Int       @id @default(autoincrement())
  usuarioId   Int       @map("usuario_id")
  usuario     Usuario   @relation(fields: [usuarioId], references: [id])
  calle       String
  distrito    String
  referencia  String?
  esPrincipal Boolean   @default(false) @map("es_principal")
  ordenes     Orden[]

  @@map("direcciones")
}

// ==========================================
// MÓDULO 2: CATÁLOGO Y VARIACIONES
// ==========================================
model Categoria {
  id        Int        @id @default(autoincrement())
  nombre    String
  activa    Boolean    @default(true)
  productos Producto[]

  @@map("categorias")
}

model Producto {
  id          Int                 @id @default(autoincrement())
  categoriaId Int                 @map("categoria_id")
  categoria   Categoria           @relation(fields: [categoriaId], references: [id])
  nombre      String
  descripcion String?
  imagenUrl   String?             @map("imagen_url")
  activo      Boolean             @default(true)
  variantes   ProductoVariante[]

  @@map("productos")
}

model Tamano {
  id        Int                @id @default(autoincrement())
  nombre    String
  variantes ProductoVariante[]

  @@map("tamanos")
}

model Masa {
  id        Int                @id @default(autoincrement())
  nombre    String
  variantes ProductoVariante[]

  @@map("masas")
}

model ProductoVariante {
  id             Int              @id @default(autoincrement())
  productoId     Int              @map("producto_id")
  producto       Producto         @relation(fields: [productoId], references: [id])
  tamanoId       Int?             @map("tamano_id")
  tamano         Tamano?          @relation(fields: [tamanoId], references: [id])
  masaId         Int?             @map("masa_id")
  masa           Masa?            @relation(fields: [masaId], references: [id])
  precio         Decimal          @db.Decimal(10, 2)
  stock          Int?
  comboItems     ComboItem[]
  detallesOrden  DetalleOrden[]

  @@map("producto_variantes")
}

// ==========================================
// MÓDULO 3: COMBOS Y PROMOCIONES
// ==========================================
model Combo {
  id            Int             @id @default(autoincrement())
  nombre        String
  descripcion   String?
  precio        Decimal         @db.Decimal(10, 2)
  imagenUrl     String?         @map("imagen_url")
  activo        Boolean         @default(true)
  items         ComboItem[]
  detallesOrden DetalleOrden[]

  @@map("combos")
}

model ComboItem {
  id         Int              @id @default(autoincrement())
  comboId    Int              @map("combo_id")
  combo      Combo            @relation(fields: [comboId], references: [id])
  varianteId Int              @map("variante_id")
  variante   ProductoVariante @relation(fields: [varianteId], references: [id])
  cantidad   Int

  @@map("combo_items")
}

// ==========================================
// MÓDULO 4 Y 5: ÓRDENES Y PAGOS
// ==========================================
model Orden {
  id          Int            @id @default(autoincrement())
  usuarioId   Int            @map("usuario_id")
  usuario     Usuario        @relation(fields: [usuarioId], references: [id])
  direccionId Int            @map("direccion_id")
  direccion   Direccion      @relation(fields: [direccionId], references: [id])
  estado      String         @default("Pendiente")
  total       Decimal        @db.Decimal(10, 2)
  creadoEn    DateTime       @default(now()) @map("creado_en")
  detalles    DetalleOrden[]
  pagos       Pago[]

  @@map("ordenes")
}

model DetalleOrden {
  id             Int               @id @default(autoincrement())
  ordenId        Int               @map("orden_id")
  orden          Orden             @relation(fields: [ordenId], references: [id])
  varianteId     Int?              @map("variante_id")
  variante       ProductoVariante? @relation(fields: [varianteId], references: [id])
  comboId        Int?              @map("combo_id")
  combo          Combo?            @relation(fields: [comboId], references: [id])
  cantidad       Int
  precioUnitario Decimal           @map("precio_unitario") @db.Decimal(10, 2)
  subtotal       Decimal           @db.Decimal(10, 2)

  @@map("detalles_orden")
}

model MetodoPago {
  id     Int     @id @default(autoincrement())
  nombre String
  activo Boolean @default(true)
  pagos  Pago[]

  @@map("metodos_pago")
}

model Pago {
  id                Int        @id @default(autoincrement())
  ordenId           Int        @map("orden_id")
  orden             Orden      @relation(fields: [ordenId], references: [id])
  metodoPagoId      Int        @map("metodo_pago_id")
  metodoPago        MetodoPago @relation(fields: [metodoPagoId], references: [id])
  monto             Decimal    @db.Decimal(10, 2)
  estado            String     @default("Pendiente")
  codigoTransaccion String?    @map("codigo_transaccion")
  creadoEn          DateTime   @default(now()) @map("creado_en")

  @@map("pagos")
}
